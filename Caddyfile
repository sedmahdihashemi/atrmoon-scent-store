# Reverse proxy + automatic HTTPS for atrmoon.top
# - Site traffic        -> the app container (Node server)
# - /sb/*               -> the Supabase backend (database/auth/storage)
#   so the browser only ever talks to YOUR domain.
#   The actual Supabase project URL is never hardcoded here — it comes
#   from the SUPABASE_UPSTREAM_HOST env var (set in .env on the server).

atrmoon.top, www.atrmoon.top {
	encode zstd gzip

	handle /sb/* {
		uri strip_prefix /sb
		reverse_proxy {$SUPABASE_UPSTREAM_HOST} {
			header_up Host {upstream_hostport}
		}
	}

	# TWA/Digital Asset Links verification file. Served directly by Caddy
	# (not the Node app) so it's never affected by the app's static-file
	# handling and always comes back as real JSON with no redirects.
	handle /.well-known/* {
		root * /srv
		header Content-Type application/json
		file_server
	}

	handle {
		reverse_proxy app:3000
	}
}
